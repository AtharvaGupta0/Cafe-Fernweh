# Café Fernweh environment configuration
# Copy this file to .env and fill in real values before running with a live provider.
# Never commit .env to source control.

# Inference provider: "gemini" or "demo" (development demonstration mode)
AI_PROVIDER=demo

# Model identifier (used when AI_PROVIDER=gemini)
AI_MODEL=gemini-3.5-flash-lite

# Gemini API key (server-side only — never expose to the browser)
# Get one from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional admin token required to opt into experimental evaluation configurations
# via the X-Fernweh-Eval header. Unset = experimental configs unavailable publicly.
DEV_ADMIN_TOKEN=

# Request timeout for inference calls (ms)
AI_REQUEST_TIMEOUT_MS=30000

# Maximum conversation turns retained per session
MAX_CONVERSATION_TURNS=10

# Maximum customer message length (characters)
MAX_MESSAGE_LENGTH=2000

# Allowed CORS origins (comma-separated). Use specific origins in production.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Database (D1) binding name used by the Worker
DB_BINDING_NAME=DB

# Admin authentication token (server-side only). Required to access protected
# administrative endpoints. Generate a strong random value; never commit it.
ADMIN_TOKEN=
